{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "labs-test",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "labs-test","database_id": "9a5da3ab-e695-47f4-9c40-32b20753f439",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "labs-test","preview_bucket_name": "labs-test",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
